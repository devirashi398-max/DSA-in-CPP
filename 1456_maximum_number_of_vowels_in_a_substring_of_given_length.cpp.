class Solution {
public:
bool isvowel(char c){
    return(c=='a'|| c=='e'|| c=='i'|| c=='o'|| c=='u');
}
    int maxVowels(string s, int k) {
        int currvowel=0;

        for(int i=0;i<k;i++){
            if(isvowel(s[i])){
                currvowel++;
            }
        }
            int max_substring=currvowel;
            
        
        for(int i=k;i<s.size();i++){
            if(isvowel(s[i])){
                currvowel++;
            }
            if(isvowel(s[i-k])){
                currvowel--;
            }
            max_substring=max(max_substring,currvowel);
         
        }
        return max_substring; 
    }         
};

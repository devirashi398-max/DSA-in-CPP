class Solution {
public:
    int mostFrequentElement(vector<int>& nums) {
       map<int,int>freq;
       for(int i=0;i<nums.size();i++){
        freq[nums[i]]++;
       }
       int max_freq=0;
       int ans=0;
       for(auto it:freq){
        if(it.second>max_freq){
            ans=it.first;
            max_freq=it.second;
        }
        else if(it.second==max_freq){
            if(ans>it.first){
                ans=it.first;
            }
        }

       }
       return ans;

    }
};

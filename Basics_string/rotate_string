class Solution {
public:
    bool rotateString(string s, string goal) {
        if(s.size()!=goal.size()) return false;
        string temp=s+s;
        for(int i=0;i<temp.size()-goal.size()+1;i++){
            int j=0;
            while(j<goal.size() && temp[i+j]==goal[j]){
                j++;
            }
            if(j==goal.size()) return true;
        }
        return false;
    }
};

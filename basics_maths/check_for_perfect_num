class Solution {
public:
    bool checkPerfectNumber(int num) {
        int sum=0;
        int dup=num;
        for(int i=1;i<num;i++){
            if(num%i==0){
                sum+=i;
            }
        }
        if(sum==dup){
            return true;
        }
        else{
            return false;
        }
    }
};
